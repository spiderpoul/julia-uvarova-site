# Скопируйте в .env и заполните данные FTP/FTPS хостинга.
FTP_HOST=ftp.example.com
FTP_PORT=21
FTP_USER=your_ftp_login
FTP_PASSWORD=your_ftp_password
# Каталог сайта: путь уточните у своего хостинга.
FTP_REMOTE_DIR=/public_html
# true: защищённый FTPS (explicit TLS); false: обычный FTP.
FTP_USE_TLS=true
FTP_TIMEOUT=30